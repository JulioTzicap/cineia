{
  "info": {"name": "CineIA API", "description": "Demostración académica sin secretos embebidos", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "event": [
    {"listen":"prerequest","script":{"exec":["if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', Date.now());"]}},
    {"listen":"test","script":{"exec":["pm.test('Respuesta HTTP correcta', () => pm.expect(pm.response.code).to.be.within(200, 299));"]}}
  ],
  "item": [
    {"name":"Autenticación","item":[
      {"name":"Login administrador","event":[{"listen":"test","script":{"exec":["pm.test('Login correcto', () => pm.response.to.have.status(200));","const data=pm.response.json();","pm.environment.set('token', data.access_token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},"url":"{{baseUrl}}/api/v1/auth/login"}},
      {"name":"Perfil actual","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/v1/auth/me"}}
    ]},
    {"name":"Catálogo","item":[
      {"name":"Listar catálogo","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/v1/catalog/items"}},
      {"name":"Crear título (ADMIN)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Título Postman {{runId}}\",\n  \"category\": \"MOVIE\",\n  \"synopsis\": \"Registro académico creado desde Postman.\",\n  \"genre\": \"Prueba\",\n  \"platform\": \"Cine\",\n  \"release_year\": 2026,\n  \"rating\": 8.0\n}"},"url":"{{baseUrl}}/api/v1/catalog/items"}}
    ]},
    {"name":"Servicios IA","item":[
      {"name":"Chat RAG","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message\":\"¿De qué trata Interestelar?\"}"},"url":"{{baseUrl}}/api/v1/ai/rag/chat"}},
      {"name":"Recomendador","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message\":\"Recomiéndame ciencia ficción con buena calificación\"}"},"url":"{{baseUrl}}/api/v1/ai/recommend"}},
      {"name":"Novedades","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message\":\"Dune película\"}"},"url":"{{baseUrl}}/api/v1/ai/news"}}
    ]},
    {"name":"Historial y reportes","item":[
      {"name":"Mi historial","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/v1/history/me"}},
      {"name":"Mi consumo","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/v1/usage/me"}},
      {"name":"Mi resumen de cuota","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/v1/usage/me/summary"}},
      {"name":"Consumo administrativo filtrado","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/v1/admin/usage?service=rag"}},
      {"name":"Consumo Power BI","request":{"method":"GET","url":"{{baseUrl}}/api/v1/bi/consumption?api_key={{biApiKey}}"}}
    ]}
  ]
}
